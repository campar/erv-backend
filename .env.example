# Copy to .env and adjust. Spring Boot reads these as environment variables.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/erv
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Base64-encoded secret used to sign JWTs, e.g. `openssl rand -base64 64`
JWT_SECRET=

# Credentials the tablet terminals use for Basic auth
DEVICE_USER_NAME=tablet
DEVICE_PASSWORD=

# Comma-separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional HTTPS (PKCS12 keystore, e.g. SSL_KEY_STORE=file:/etc/erv/keystore.p12)
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=

# Seed an empty database with demo data on startup
SEED_DEMO_DATA=false
